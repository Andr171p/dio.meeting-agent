# ====================================== Playwright ================================================
PLAYWRIGHT_VERSION=1.64.0

# ====================================== Browser server ============================================
BROWSER_HOST=127.0.0.1
BROWSER_PORT=3000
BROWSER_WS_PATH=/ws/replace-with-long-random-secret

# ============================================ Virtual display =====================================
BROWSER_DISPLAY=:99
BROWSER_SCREEN_WIDTH=1920
BROWSER_SCREEN_HEIGHT=1080
BROWSER_SCREEN_DEPTH=24

# ============================================ Runtime resources ===================================
BROWSER_SHM_SIZE=1gb
BROWSER_RECORDINGS_PATH=./data/recordings

# ============================================ Chromium ============================================
BROWSER_AUTOPLAY_POLICY=no-user-gesture-required